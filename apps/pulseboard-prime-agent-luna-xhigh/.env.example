# Prefer DATABASE_URL in deployment, or set discrete POSTGRES_* vars.
DATABASE_URL=
POSTGRES_USER=pulseboard
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseboard

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3110
# Optional comma-separated proxy CIDRs/IPs for trusted client IP rate limiting.
TRUSTED_PROXIES=

# App
VITE_APP_URL=http://localhost:3110
NODE_ENV=development
