{
  "name": "harness-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmark coding harnesses (Prime Agent, Claude Code, Codex) on fullstack TanStack Start apps",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "bench": "bun run --filter @harness-bench/bench bench",
    "bench:tasks": "bun run bench -- tasks",
    "bench:harnesses": "bun run bench -- harnesses",
    "bench:presets": "bun run bench -- presets",
    "bench:report": "bun run bench -- report"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
